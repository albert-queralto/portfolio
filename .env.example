# RAGFlow Cloud or a remote RAGFlow installation.
# Do not add a trailing slash.
RAGFLOW_BASE_URL=https://cloud.ragflow.io
RAGFLOW_CHAT_ID=replace-with-chat-assistant-id
RAGFLOW_API_KEY=replace-with-ragflow-api-key

# Generate with: openssl rand -hex 32
# Use the same value as the API key when adding Ollama in RAGFlow.
OLLAMA_GATEWAY_TOKEN=replace-with-a-long-random-token
