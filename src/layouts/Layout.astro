---
import { ClientRouter } from "astro:transitions";
import { site } from "@/data/site";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const {
  title = site.title,
  description = site.description,
  canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).toString(),
  type = "website",
  noindex = false,
} = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: site.url,
  jobTitle: site.role,
  description: site.description,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Barcelona",
    addressCountry: "ES",
  },
  alumniOf: [
    {
      "@type": "CollegeOrUniversity",
      name: "Universitat Autònoma de Barcelona",
    },
    {
      "@type": "CollegeOrUniversity",
      name: "Universitat Oberta de Catalunya",
    },
  ],
  sameAs: [site.github, site.linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="keywords" content={site.keywords.join(", ")} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#101010" />
    <meta name="color-scheme" content="dark light" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href="/favicon.png" as="image" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={`${site.name} Portfolio`} />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem("theme");
        const prefersLight = window.matchMedia("(prefers-color-scheme: light)").matches;
        const isLight = savedTheme ? savedTheme === "light" : prefersLight;
        document.documentElement.classList.toggle("light", isLight);
        document.documentElement.style.colorScheme = isLight ? "light" : "dark";
      })();
    </script>

    <ClientRouter />
    <slot name="head" />
  </head>
  <body class="bg-[var(--background)] px-5 text-[var(--white)] sm:px-8 lg:px-10">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --background: #101010;
    --background-rgb: 16, 16, 16;
    --sec: #76bdff;
    --sec-strong: #a9d7ff;
    --white: #f1f3f5;
    --white-icon: #b0b3b8;
    --white-icon-tr: #f3f3f314;
    --component-bg: #1a1a1a;
    --card-bg: #151515cc;
    --border: #ffffff16;
    --success: #83d8a2;
    --error: #ff9b9b;
  }

  html.light {
    --background: #f7f8fa;
    --background-rgb: 247, 248, 250;
    --sec: #1768b3;
    --sec-strong: #0f4f8c;
    --white: #111827;
    --white-icon: #4b5563;
    --white-icon-tr: #11182714;
    --component-bg: #ffffff;
    --card-bg: #ffffffd9;
    --border: #11182718;
    --success: #137a3d;
    --error: #b42318;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    min-width: 320px;
    scroll-behavior: smooth;
    scroll-padding-top: 7rem;
    background: var(--background);
  }

  body {
    min-height: 100vh;
    margin: 0;
    background: var(--background);
    color: var(--white);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    line-height: 1.6;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  button,
  input,
  textarea {
    font: inherit;
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  a,
  button,
  input,
  textarea,
  summary {
    outline-offset: 4px;
  }

  :focus-visible {
    outline: 2px solid var(--sec);
  }

  ::selection {
    background: var(--sec);
    color: var(--background);
  }

  .skip-link {
    position: fixed;
    left: 1rem;
    top: 1rem;
    z-index: 999;
    transform: translateY(-180%);
    border-radius: 0.75rem;
    background: var(--sec);
    color: var(--background);
    padding: 0.65rem 1rem;
    font-weight: 700;
    transition: transform 150ms ease;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .surface-border {
    border-color: var(--border);
  }

  ::-webkit-scrollbar {
    width: 10px;
  }

  ::-webkit-scrollbar-track {
    background: var(--background);
  }

  ::-webkit-scrollbar-thumb {
    border: 2px solid var(--background);
    border-radius: 999px;
    background: var(--white-icon);
  }

  * {
    scrollbar-color: var(--white-icon) var(--background);
    scrollbar-width: thin;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
