---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";
---

<Layout title="Page not found — Albert Queraltó" description="The requested page could not be found." noindex>
  <Nav />
  <main id="main-content" class="mx-auto flex min-h-[75vh] max-w-3xl flex-col items-start justify-center py-28">
    <p class="text-sm font-semibold uppercase tracking-[0.15em] text-[var(--sec)]">404 error</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-6xl">This page is not here.</h1>
    <p class="mt-5 max-w-xl text-[var(--white-icon)]">
      The address may be outdated, or the page may have moved. The home page and project
      archive are still available.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="rounded-xl bg-[var(--sec)] px-5 py-3 text-sm font-semibold text-[var(--background)]">Go home</a>
      <a href="/#projects" class="rounded-xl border border-[var(--border)] bg-[var(--card-bg)] px-5 py-3 text-sm font-medium text-[var(--white)]">View projects</a>
    </div>
  </main>
  <Footer />
</Layout>
