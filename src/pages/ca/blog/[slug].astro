---
import BlogPostPage from "@/components/pages/BlogPostPage.astro";
import { getLocalizedBlogEntries } from "@/i18n/content";

export async function getStaticPaths() {
  const posts = await getLocalizedBlogEntries("ca");
  return posts.map(({ key }) => ({ params: { slug: key }, props: { translationKey: key } }));
}

interface Props { translationKey: string; }
const { translationKey } = Astro.props;
---
<BlogPostPage translationKey={translationKey} />
