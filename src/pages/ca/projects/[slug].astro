---
import ProjectDetailPage from "@/components/pages/ProjectDetailPage.astro";
import { getLocalizedProjectEntries } from "@/i18n/content";

export async function getStaticPaths() {
  const projects = await getLocalizedProjectEntries("ca");
  return projects.map(({ key }) => ({ params: { slug: key }, props: { translationKey: key } }));
}

interface Props { translationKey: string; }
const { translationKey } = Astro.props;
---
<ProjectDetailPage translationKey={translationKey} />
