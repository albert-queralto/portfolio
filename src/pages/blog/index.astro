---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";
import { getCollection } from "astro:content";
import { site } from "@/data/site";
import { toCanonicalUrl } from "@/utils/urls";
import { buildBreadcrumbList } from "@/utils/seo";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((post) => {
    const postBody = post.body ?? "";
    return {
      ...post,
      readingTime: Math.max(1, Math.ceil(postBody.trim().split(/\s+/).length / 220)),
    };
  });

const canonical = toCanonicalUrl("/blog/", Astro.site ?? site.url);
const structuredData = [
  buildBreadcrumbList([
    { name: "Home", url: toCanonicalUrl("/", Astro.site ?? site.url) },
    { name: "Blog", url: canonical },
  ]),
];
---

<Layout
  title="Machine Learning & Data Science Blog — Albert Queraltó"
  description="Practical explanations of machine learning, deep learning, data science, and the engineering decisions behind reliable models."
  canonical={canonical}
  structuredData={structuredData}
>
  <Nav />
  <main id="main-content" class="mx-auto max-w-5xl py-24 text-[var(--white)] md:py-36">
    <header class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.15em] text-[var(--sec)]">Writing</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">
        Machine learning, explained from first principles.
      </h1>
      <p class="mt-5 text-[var(--white-icon)] md:text-lg">
        Notes on model architectures, optimisation, feature engineering, and practical
        machine-learning workflows—written to make the underlying ideas reusable.
      </p>
    </header>

    <div class="mt-12 grid gap-5 md:grid-cols-2">
      {
        posts.map((post) => (
          <article class="group rounded-2xl border border-[var(--border)] bg-[var(--card-bg)] transition-[border-color,transform] hover:-translate-y-0.5 hover:border-[var(--sec)]">
            <a href={`/blog/${post.id}/`} class="flex h-full flex-col p-6">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-[var(--white-icon)]">
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString("en-GB", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
                <span aria-hidden="true">·</span>
                <span>{post.readingTime} min read</span>
              </div>
              <h2 class="mt-4 text-xl font-semibold leading-snug transition-colors group-hover:text-[var(--sec)]">
                {post.data.title}
              </h2>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-[var(--white-icon)]">
                {post.data.description}
              </p>
              <ul class="mt-5 flex flex-wrap gap-2" aria-label="Article topics">
                {post.data.tags.slice(0, 3).map((tag) => (
                  <li class="rounded-md bg-[var(--white-icon-tr)] px-2 py-1 text-xs text-[var(--sec-strong)]">
                    {tag}
                  </li>
                ))}
              </ul>
              <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-[var(--white)]">
                Read article
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-4 transition-transform group-hover:translate-x-1">
                  <path d="m16 9.41-8.6 8.61-1.42-1.41L14.59 8H7V6h11v11h-2V9.41Z" />
                </svg>
              </span>
            </a>
          </article>
        ))
      }
    </div>
  </main>
  <Footer />
</Layout>
