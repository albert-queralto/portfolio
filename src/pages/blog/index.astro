---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";
import { getCollection } from "astro:content";
import { site } from "@/data/site";
import { toCanonicalUrl } from "@/utils/urls";
import { buildBreadcrumbList } from "@/utils/seo";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((post) => {
    const postBody = post.body ?? "";
    return {
      ...post,
      cover: post.data.cover ?? "/og/default.png",
      readingTime: Math.max(1, Math.ceil(postBody.trim().split(/\s+/).length / 220)),
    };
  });

const INITIAL_POST_COUNT = 6;

const additionalPostCount = Math.max(
  posts.length - INITIAL_POST_COUNT,
  0,
);

const canonical = toCanonicalUrl("/blog/", Astro.site ?? site.url);
const structuredData = [
  buildBreadcrumbList([
    { name: "Home", url: toCanonicalUrl("/", Astro.site ?? site.url) },
    { name: "Blog", url: canonical },
  ]),
];
---

<Layout
  title="Machine Learning & Software Engineering Blog — Albert Queraltó"
  description="Practical explanations of machine learning, deep learning, data science, and the engineering decisions behind reliable models."
  canonical={canonical}
  structuredData={structuredData}
>
  <Nav />
  <main id="main-content" class="mx-auto max-w-5xl py-24 text-[var(--white)] md:py-36">
    <header class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.15em] text-[var(--sec)]">Writing</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">
        Building production ML and software systems.
      </h1>
      <p class="mt-5 text-[var(--white-icon)] md:text-lg">
        Engineering notes from real systems I build: machine-learning pipelines, SaaS architecture, background jobs, data ingestion, decision systems, deployment, and the trade-offs behind them.
      </p>
    </header>

    <div
      id="blog-posts-grid"
      class="mt-12 grid gap-6 md:grid-cols-2"
    >
      {
        posts.map((post, index) => (
          <article 
            data-blog-additional={String(index >= INITIAL_POST_COUNT ? "true" : "false")}
            class:list={[
              "group overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--card-bg)] transition-[border-color,transform] hover:-translate-y-0.5 hover:border-[var(--sec)]",
              index >= INITIAL_POST_COUNT && "hidden",
            ]}
          >
            <a href={`/blog/${post.id}/`} class="flex h-full flex-col">
              <img
                src={post.cover}
                alt={`${post.data.title} cover image`}
                width="1200"
                height="630"
                loading="lazy"
                decoding="async"
                class="aspect-[1200/630] w-full border-b border-[var(--border)] object-cover transition-transform duration-500 group-hover:scale-[1.02]"
              />

              <div class="flex flex-1 flex-col p-6">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-[var(--white-icon)]">
                  <time datetime={post.data.date.toISOString()}>
                    {post.data.date.toLocaleDateString("en-GB", {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </time>
                  <span aria-hidden="true">·</span>
                  <span>{post.readingTime} min read</span>
                </div>
                <h2 class="mt-4 text-xl font-semibold leading-snug transition-colors group-hover:text-[var(--sec)]">
                  {post.data.title}
                </h2>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-[var(--white-icon)]">
                  {post.data.description}
                </p>
                <ul class="mt-5 flex flex-wrap gap-2" aria-label="Article topics">
                  {post.data.tags.slice(0, 3).map((tag) => (
                    <li class="rounded-md bg-[var(--white-icon-tr)] px-2 py-1 text-xs text-[var(--sec-strong)]">
                      {tag}
                    </li>
                  ))}
                </ul>
                <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-[var(--white)]">
                  Read article
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-4 transition-transform group-hover:translate-x-1">
                    <path d="m16 9.41-8.6 8.61-1.42-1.41L14.59 8H7V6h11v11h-2V9.41Z" />
                  </svg>
                </span>
              </div>
            </a>
          </article>
        ))
      }
    </div>
    {
      additionalPostCount > 0 && (
        <div
          id="blog-expander-container"
          class="mt-10 flex justify-center"
        >
          <button
            id="blog-expander"
            type="button"
            aria-expanded="false"
            aria-controls="blog-posts-grid"
            data-more-label={`View ${additionalPostCount} more articles →`}
            data-less-label="Show fewer articles ↑"
            class="inline-flex min-h-11 items-center justify-center rounded-xl border border-[var(--border)] bg-[var(--card-bg)] px-5 py-2.5 text-sm font-semibold text-[var(--white-icon)] transition-colors hover:border-[var(--sec)] hover:text-[var(--white)]"
          >
            View {additionalPostCount} more articles →
          </button>
        </div>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  function setupBlogExpander() {
    const button = document.getElementById("blog-expander");

    if (!(button instanceof HTMLButtonElement)) {
      return;
    }

    // Prevent duplicate listeners with Astro navigation.
    if (button.dataset.initialized === "true") {
      return;
    }

    button.dataset.initialized = "true";

    const additionalPosts = document.querySelectorAll(
      '[data-blog-additional="true"]',
    );

    let expanded = false;

    button.addEventListener("click", () => {
      expanded = !expanded;

      additionalPosts.forEach((post) => {
        post.classList.toggle("hidden", !expanded);
      });

      button.setAttribute(
        "aria-expanded",
        expanded ? "true" : "false",
      );

      button.textContent = expanded
        ? button.dataset.lessLabel || "Show fewer articles ↑"
        : button.dataset.moreLabel || "View more articles →";
    });
  }

  setupBlogExpander();

  document.addEventListener(
    "astro:page-load",
    setupBlogExpander,
  );
</script>