---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";
import { site } from "@/data/site";
import { toCanonicalUrl } from "@/utils/urls";
import { buildBlogPosting, buildBreadcrumbList } from "@/utils/seo";
import { getCollection, getEntry, render, type CollectionEntry } from "astro:content";
import "katex/dist/katex.min.css";
import "@/styles/prose.css"
import TableOfContents from "@/components/TableOfContents.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const relatedProject = post.data.project
  ? await getEntry("projects", post.data.project)
  : undefined;
const { Content, headings } = await render(post);
const postBody = post.body ?? "";
const readingTime = Math.max(1, Math.ceil(postBody.trim().split(/\s+/).length / 220));
const canonical = toCanonicalUrl(
  `/blog/${post.id}/`,
  Astro.site ?? site.url,
);
const words = postBody.trim() ? postBody.trim().split(/\s+/).length : 0;
const ogImage = post.data.cover ?? "/og/default.png";
const structuredData = [
  buildBlogPosting({
    canonical,
    title: post.data.title,
    description: post.data.description,
    published: post.data.date,
    modified: post.data.updatedDate,
    image: ogImage,
    tags: post.data.tags,
    readingTimeMinutes: readingTime,
    wordCount: words,
    section: post.data.series,
  }),
  buildBreadcrumbList([
    { name: "Home", url: toCanonicalUrl("/", Astro.site ?? site.url) },
    { name: "Blog", url: toCanonicalUrl("/blog/", Astro.site ?? site.url) },
    { name: post.data.title, url: canonical },
  ]),
];
---

<Layout
  title={`${post.data.title} — ${site.name}`}
  description={post.data.description}
  canonical={canonical}
  type="article"
  ogImage={ogImage}
  ogImageAlt={`${post.data.title} — article by ${site.name}`}
  structuredData={structuredData}
>
  <meta slot="head" property="article:published_time" content={post.data.date.toISOString()} />
  {post.data.updatedDate && (
    <meta slot="head" property="article:modified_time" content={post.data.updatedDate.toISOString()} />
  )}
  {post.data.tags.map((tag) => <meta slot="head" property="article:tag" content={tag} />)}

  <Nav />
    <main
      id="main-content"
      data-analytics-blog-page
      data-analytics-blog-id={post.id}
      data-analytics-blog-title={post.data.title}
      class="mx-auto max-w-6xl py-24 text-[var(--white)] md:py-36"
    >
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_240px]">
        <article class="min-w-0">
    <article>
      <a
        href="/blog/"
        class="inline-flex min-h-10 items-center gap-2 rounded-lg text-sm font-medium text-[var(--white-icon)] transition-colors hover:text-[var(--white)]"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-4">
          <path d="M7.83 11H20v2H7.83l5.36 5.36-1.41 1.42L4 12l7.78-7.78 1.41 1.42L7.83 11Z" />
        </svg>
        Back to all articles
      </a>

      <header class="mt-10 border-b border-[var(--border)] pb-10">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-[var(--white-icon)]">
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString("en-GB", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </time>
          <span aria-hidden="true">·</span>
          <span>{readingTime} min read</span>
        </div>

        <h1 class="mt-4 text-balance text-3xl font-semibold leading-tight tracking-tight md:text-5xl">
          {post.data.title}
        </h1>
        <p class="mt-5 text-base leading-relaxed text-[var(--white-icon)] md:text-lg">
          {post.data.description}
        </p>

        <ul class="mt-6 flex flex-wrap gap-2" aria-label="Article topics">
          {post.data.tags.map((tag) => (
            <li class="rounded-md bg-[var(--white-icon-tr)] px-2.5 py-1 text-xs text-[var(--sec-strong)]">
              {tag}
            </li>
          ))}
        </ul>
      </header>
      {
        relatedProject && (
          <aside class="mt-8 rounded-2xl border border-[var(--border)] bg-[var(--card-bg)] p-5">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--sec)]">
              Related project
            </p>

            <h2 class="mt-2 text-lg font-semibold">
              {relatedProject.data.title}
            </h2>

            <p class="mt-2 text-sm leading-relaxed text-[var(--white-icon)]">
              {relatedProject.data.description}
            </p>

            <a
              href={`/projects/${relatedProject.id}/`}
              class="mt-4 inline-flex text-sm font-semibold text-[var(--sec-strong)] hover:underline"
            >
              View the complete case study →
            </a>
          </aside>
        )
      }

      <div
        data-analytics-blog-content
        class="article-prose prose mt-10 max-w-none prose-headings:scroll-mt-28 prose-headings:font-semibold prose-a:no-underline hover:prose-a:underline prose-code:before:content-none prose-code:after:content-none"
      >
        <Content />
      </div>
    </article>
      <TableOfContents headings={headings} />
    </div>
  </main>
  <Footer />
</Layout>
