---
interface NavItem {
  label: string;
  href: string;
  homeSection?: string;
  icon: string;
}

const currentPath = Astro.url.pathname;
const isHome = currentPath === "/";

const navItems: NavItem[] = [
  {
    label: "Home",
    href: isHome ? "#home" : "/#home",
    homeSection: "home",
    icon: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.49a1 1 0 0 1 .39-.79l8-6.22a1 1 0 0 1 1.22 0l8 6.22a1 1 0 0 1 .39.79V20Zm-2-1V9.98l-7-5.45-7 5.45V19h14Z"/></svg>`,
  },
  {
    label: "Projects",
    href: isHome ? "#projects" : "/#projects",
    homeSection: "projects",
    icon: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.41 5H21a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h7.41l2 2ZM4 5v14h16V7h-8.41l-2-2H4Z"/></svg>`,
  },
  {
    label: "Blog",
    href: "/blog/",
    icon: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 22H4a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1h16a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1Zm-1-2V4H5v16h14ZM7 6h4v4H7V6Zm0 6h10v2H7v-2Zm0 4h10v2H7v-2Zm6-9h4v2h-4V7Z"/></svg>`,
  },
  {
    label: "Contact",
    href: isHome ? "#contact" : "/#contact",
    homeSection: "contact",
    icon: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21.73 2.96-5.46 19.08c-.15.53-.47.56-.71.07L11 13 1.92 9.37c-.51-.2-.5-.51.04-.69l19.08-6.36c.53-.18.83.12.69.64ZM19.04 5.1 6.81 9.17l5.64 2.26 3.04 6.08 3.55-12.41Z"/></svg>`,
  },
];
---

<div class="pointer-events-none fixed inset-x-0 z-[100] flex justify-center px-3 md:top-6">
  <nav
    id="main-nav"
    aria-label="Primary navigation"
    class="pointer-events-auto fixed bottom-0 left-1/2 w-full -translate-x-1/2 border border-[var(--border)] nav-surface backdrop-blur-xl transition-[width,background-color,border-radius] duration-500 md:static md:w-[min(80%,760px)] md:translate-x-0 md:rounded-full"
  >
    <ul class="mx-auto flex min-h-16 items-stretch justify-between px-2 md:min-h-14 md:items-center md:justify-center md:gap-10 md:px-5">
      {
        navItems.map((item) => {
          const isBlogActive = currentPath.startsWith("/blog") && item.href === "/blog/";
          const isServerActive = isBlogActive || (isHome && item.homeSection === "home");

          return (
            <li class="flex min-w-0 flex-1 md:flex-none">
              <a
                href={item.href}
                data-section={item.homeSection}
                aria-current={isServerActive ? "page" : undefined}
                class:list={[
                  "nav-link relative flex min-h-14 w-full flex-col items-center justify-center gap-0.5 rounded-xl px-2 text-[11px] font-medium text-[var(--white-icon)] transition-colors hover:text-[var(--white)] md:min-h-0 md:w-auto md:flex-row md:gap-2 md:px-1 md:py-2 md:text-sm",
                  { active: isServerActive },
                ]}
              >
                <span class="nav-icon size-5 fill-current md:hidden" set:html={item.icon} />
                <span class="truncate">{item.label}</span>
                <span class="nav-indicator absolute bottom-1 h-1 w-1 scale-0 rounded-full bg-[var(--sec)] opacity-0 transition-all md:-left-4 md:bottom-auto md:top-1/2 md:-translate-y-1/2" />
              </a>
            </li>
          );
        })
      }
      <li class="flex flex-1 items-center justify-center md:flex-none">
        <button
          id="theme-toggle"
          type="button"
          class="flex size-11 items-center justify-center rounded-xl text-[var(--white-icon)] transition-colors hover:text-[var(--white)] md:size-9"
          aria-label="Switch to light theme"
          aria-pressed="false"
          title="Switch colour theme"
        >
          <svg id="toggle-sun" aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-current">
            <path d="M12 18a6 6 0 1 1 0-12 6 6 0 0 1 0 12Zm0-2a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM11 1h2v3h-2V1Zm0 19h2v3h-2v-3ZM3.51 4.93l1.42-1.42 2.12 2.13-1.41 1.41-2.13-2.12Zm13.44 13.43 1.41-1.41 2.13 2.12-1.42 1.42-2.12-2.13Zm2.12-14.85 1.42 1.42-2.13 2.12-1.41-1.41 2.12-2.13ZM5.64 16.95l1.41 1.41-2.12 2.13-1.42-1.42 2.13-2.12ZM23 11v2h-3v-2h3ZM4 11v2H1v-2h3Z" />
          </svg>
          <svg id="toggle-moon" aria-hidden="true" viewBox="0 0 24 24" class="hidden size-5 fill-current">
            <path d="M10.36 2.05a9.5 9.5 0 1 0 11.59 11.59A7.5 7.5 0 0 1 10.36 2.05ZM4 12a7.5 7.5 0 0 1 4.1-6.68A9.51 9.51 0 0 0 18.68 15.9 7.5 7.5 0 0 1 4 12Z" />
          </svg>
        </button>
      </li>
    </ul>
  </nav>
</div>

<style>
  .nav-surface {
    background: rgba(var(--background-rgb), 0.88);
  }

  .nav-icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  nav.scrolling {
    background-color: color-mix(in srgb, var(--component-bg) 92%, transparent);
  }

  .nav-link.active {
    color: var(--white);
  }

  .nav-link.active .nav-indicator {
    opacity: 1;
    transform: scale(1);
  }

  @media (min-width: 768px) {
    .nav-link.active .nav-indicator {
      transform: translateY(-50%) scale(1);
    }
  }

  @media (max-width: 767px) {
    nav {
      padding-bottom: env(safe-area-inset-bottom);
      border-radius: 1rem 1rem 0 0;
    }
  }
</style>

<style is:global>
  body {
    padding-bottom: calc(4rem + env(safe-area-inset-bottom));
  }

  html.light #toggle-sun {
    display: none;
  }

  html.light #toggle-moon {
    display: block;
  }

  @media (min-width: 768px) {
    body {
      padding-bottom: 0;
    }
  }
</style>

<script>
  let cleanupNav: (() => void) | undefined;

  document.addEventListener("astro:page-load", () => {
    cleanupNav?.();

    const controller = new AbortController();
    const { signal } = controller;
    const nav = document.getElementById("main-nav");
    const toggle = document.getElementById("theme-toggle");
    const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".nav-link"));
    const sectionLinks = navLinks.filter((link) => link.dataset.section);
    let animationFrame: number | undefined;
    let observer: IntersectionObserver | undefined;

    const updateThemeControls = () => {
      const isLight = document.documentElement.classList.contains("light");
      document.documentElement.style.colorScheme = isLight ? "light" : "dark";
      toggle?.setAttribute("aria-pressed", String(isLight));
      toggle?.setAttribute(
        "aria-label",
        isLight ? "Switch to dark theme" : "Switch to light theme",
      );
      document
        .querySelector<HTMLMetaElement>('meta[name="theme-color"]')
        ?.setAttribute("content", isLight ? "#f7f8fa" : "#101010");
    };

    updateThemeControls();

    toggle?.addEventListener(
      "click",
      () => {
        const isLight = !document.documentElement.classList.contains("light");
        document.documentElement.classList.toggle("light", isLight);
        localStorage.setItem("theme", isLight ? "light" : "dark");
        updateThemeControls();
      },
      { signal },
    );

    const updateNav = () => {
      if (!nav) return;
      const hasScrolled = window.scrollY > 8;
      nav.classList.toggle("scrolling", hasScrolled);

      if (window.innerWidth >= 768) {
        const progress = Math.min(window.scrollY / 900, 1);
        const eased = 1 - Math.pow(1 - progress, 4);
        const maxWidth = Math.min(window.innerWidth * 0.8, 760);
        const minWidth = 520;
        nav.style.width = `${maxWidth - (maxWidth - minWidth) * eased}px`;
      } else {
        nav.style.removeProperty("width");
      }
      animationFrame = undefined;
    };

    const requestNavUpdate = () => {
      if (animationFrame === undefined) {
        animationFrame = requestAnimationFrame(updateNav);
      }
    };

    window.addEventListener("scroll", requestNavUpdate, { passive: true, signal });
    window.addEventListener("resize", requestNavUpdate, { passive: true, signal });
    updateNav();

    if (window.location.pathname === "/" && sectionLinks.length > 0) {
      const setActiveSection = (id: string) => {
        sectionLinks.forEach((link) => {
          const isActive = link.dataset.section === id;
          link.classList.toggle("active", isActive);
          if (isActive) link.setAttribute("aria-current", "location");
          else link.removeAttribute("aria-current");
        });
      };

      const sections = Array.from(document.querySelectorAll<HTMLElement>("section[id]"));
      observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (visible?.target.id) setActiveSection(visible.target.id);
        },
        { rootMargin: "-20% 0px -55%", threshold: [0.1, 0.35, 0.65] },
      );
      sections.forEach((section) => observer?.observe(section));
    }

    cleanupNav = () => {
      controller.abort();
      observer?.disconnect();
      if (animationFrame !== undefined) cancelAnimationFrame(animationFrame);
    };
  });
</script>
