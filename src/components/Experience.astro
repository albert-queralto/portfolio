---
import { getLocale, getMessages } from "@/i18n/utils";
import { experienceByLocale } from "@/i18n/experience";

const locale = getLocale(Astro.currentLocale);
const t = getMessages(locale);
const experience = experienceByLocale[locale];
---

<section
  id="experience"
  aria-labelledby="experience-title"
  class="border-t border-[var(--border)] py-16 text-[var(--white)] md:py-24"
>
  <div class="mx-auto max-w-5xl">
    <div class="max-w-3xl">
      <p
        class="text-sm font-semibold uppercase tracking-[0.15em] text-[var(--sec)]"
      >
        {t.experience.eyebrow}
      </p>

      <h2
        id="experience-title"
        class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl"
      >
        {t.experience.title}
      </h2>

      <p class="mt-5 text-[var(--white-icon)] md:text-lg">
        {t.experience.description}
      </p>
    </div>

    <ol class="mt-12 space-y-6">
      {
        experience.map((position) => (
          <li class="grid gap-4 rounded-2xl border border-[var(--border)] bg-[var(--card-bg)] p-5 md:grid-cols-[190px_1fr] md:p-7">
            <div>
              <p class="text-sm font-medium text-[var(--sec)]">
                {position.period}
              </p>
            </div>

            <div>
              <h3 class="text-xl font-semibold">{position.role}</h3>

              <p class="mt-1 text-sm text-[var(--white-icon)]">
                {position.company} · {position.location}
              </p>

              <ul class="mt-5 space-y-2 text-sm leading-relaxed text-[var(--white-icon)]">
                {position.achievements.map((achievement) => (
                  <li class="flex gap-3">
                    <span class="mt-2 size-1.5 shrink-0 rounded-full bg-[var(--sec)]" />
                    <span>{achievement}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>