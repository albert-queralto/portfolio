---
import { getCollection } from "astro:content";

const projects = (
  await getCollection("projects", ({ data }) => !data.draft)
).sort((a, b) => a.data.order - b.data.order);

const categories = [
  "All",
  ...Array.from(
    new Set(projects.map((project) => project.data.category)),
  ),
];
---

<section
  id="projects"
  aria-labelledby="projects-title"
  class="border-t border-[var(--border)] py-16 text-[var(--white)] md:py-24"
>
  <div class="mx-auto max-w-5xl">
    <div class="max-w-3xl">
      <p
        class="text-sm font-semibold uppercase tracking-[0.15em] text-[var(--sec)]"
      >
        Selected work
      </p>

      <h2
        id="projects-title"
        class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl"
      >
        Projects that connect models, data, and software.
      </h2>

      <p class="mt-4 text-[var(--white-icon)] md:text-lg">
        Machine-learning systems, analytical products, data pipelines, and web
        applications with detailed explanations of the decisions behind them.
      </p>
    </div>

    <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
      <div
        id="project-filters"
        class="flex flex-wrap gap-2"
        aria-label="Filter projects"
      >
        {
          categories.map((category) => (
            <button
              type="button"
              data-filter={category}
              aria-pressed={category === "All" ? "true" : "false"}
              class="project-filter min-h-10 rounded-full border border-[var(--border)] bg-[var(--card-bg)] px-4 py-2 text-sm font-medium text-[var(--white-icon)] transition-colors hover:border-[var(--sec)] hover:text-[var(--white)]"
            >
              {category}
            </button>
          ))
        }
      </div>

      <p
        id="project-count"
        class="text-sm text-[var(--white-icon)]"
        aria-live="polite"
      >
        {projects.length} projects
      </p>
    </div>

    <div
      id="projects-grid"
      class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2"
    >
      {
        projects.map((project) => (
          <article
            class:list={[
              "project-card group flex flex-col overflow-hidden rounded-2xl border bg-[var(--card-bg)] transition-[border-color,transform] duration-300 hover:-translate-y-1 hover:border-[var(--sec)]",
              project.data.featured
                ? "border-[var(--sec)]"
                : "border-[var(--border)]",
            ]}
            data-category={project.data.category}
          >
            <a
              href={`/projects/${project.id}`}
              class="block overflow-hidden border-b border-[var(--border)]"
            >
              <img
                src={project.data.image}
                alt={`${project.data.title} application preview`}
                width="1600"
                height="1000"
                loading="lazy"
                decoding="async"
                class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
            </a>

            <div class="flex flex-1 flex-col p-5">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p
                    class="text-xs font-semibold uppercase tracking-[0.12em] text-[var(--sec)]"
                  >
                    {project.data.focus}
                  </p>

                  <h3 class="mt-2 text-xl font-semibold leading-tight">
                    <a
                      href={`/projects/${project.id}`}
                      class="hover:text-[var(--sec)]"
                    >
                      {project.data.title}
                    </a>
                  </h3>
                </div>

                <span
                  class="shrink-0 rounded-full border border-[var(--border)] px-2.5 py-1 text-xs text-[var(--white-icon)]"
                >
                  {project.data.status}
                </span>
              </div>

              <p
                class="mt-4 flex-1 text-sm leading-relaxed text-[var(--white-icon)]"
              >
                {project.data.description}
              </p>

              <ul
                class="mt-5 flex flex-wrap gap-2"
                aria-label={`${project.data.title} technologies`}
              >
                {
                  project.data.technologies.slice(0, 5).map((technology) => (
                    <li class="rounded-md bg-[var(--white-icon-tr)] px-2 py-1 text-xs text-[var(--sec-strong)]">
                      {technology}
                    </li>
                  ))
                }
              </ul>

              <div
                class="mt-5 flex flex-wrap gap-2 border-t border-[var(--border)] pt-4"
              >
                <a
                  href={`/projects/${project.id}`}
                  class="inline-flex min-h-10 items-center rounded-xl border border-[var(--border)] px-3 py-2 text-sm font-medium hover:border-[var(--sec)]"
                >
                  View case study
                </a>

                {
                  project.data.preview && (
                    <a
                      href={project.data.preview}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex min-h-10 items-center rounded-xl border border-[var(--border)] px-3 py-2 text-sm font-medium text-[var(--white-icon)] hover:border-[var(--sec)] hover:text-[var(--white)]"
                    >
                      Live preview
                    </a>
                  )
                }
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .project-filter[aria-pressed="true"] {
    border-color: var(--sec);
    background: var(--sec);
    color: var(--background);
  }
</style>

<script>
  function initialiseProjectFilters() {
    const filterContainer =
      document.getElementById("project-filters");
    const grid = document.getElementById("projects-grid");
    const count = document.getElementById("project-count");

    if (
      !filterContainer ||
      !grid ||
      filterContainer.dataset.ready === "true"
    ) {
      return;
    }

    filterContainer.dataset.ready = "true";

    const filters = Array.from(
      filterContainer.querySelectorAll<HTMLButtonElement>(
        "button[data-filter]",
      ),
    );

    const cards = Array.from(
      grid.querySelectorAll<HTMLElement>(
        ".project-card[data-category]",
      ),
    );

    filterContainer.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>(
        "button[data-filter]",
      );

      if (!button) return;

      const selected = button.dataset.filter ?? "All";
      let visibleCount = 0;

      filters.forEach((filter) => {
        filter.setAttribute(
          "aria-pressed",
          String(filter === button),
        );
      });

      cards.forEach((card) => {
        const visible =
          selected === "All" ||
          card.dataset.category === selected;

        card.hidden = !visible;

        if (visible) {
          visibleCount += 1;
        }
      });

      if (count) {
        count.textContent = `${visibleCount} ${
          visibleCount === 1 ? "project" : "projects"
        }`;
      }
    });
  }

  document.addEventListener(
    "astro:page-load",
    initialiseProjectFilters,
  );
</script>