---
import { getLocale, getMessages, localizePath } from "@/i18n/utils";
import { getFlagships } from "@/i18n/flagships";

const locale = getLocale(Astro.currentLocale);
const t = getMessages(locale);
const flagships = getFlagships(locale);
---

<section id="featured-project" aria-labelledby="featured-project-title" class="border-t border-[var(--border)] py-16 text-[var(--white)] md:py-24">
  <div class="mx-auto max-w-5xl">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.15em] text-[var(--sec)]">{t.featured.eyebrow}</p>
      <h2 id="featured-project-title" class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">{t.featured.title}</h2>
      <p class="mt-4 text-[var(--white-icon)] md:text-lg">{t.featured.description}</p>
    </div>

    <div class="mt-10 space-y-12 md:mt-14 md:space-y-16">
      {flagships.map((project) => (
        <article id={`flagship-${project.id}`} aria-labelledby={`flagship-${project.id}-title`} data-analytics-project-id={project.id} data-analytics-project-title={project.title} class="grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.15em] text-[var(--sec)]">{project.eyebrow}</p>
            <h3 id={`flagship-${project.id}-title`} class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">{project.heading}</h3>
            <p class="mt-5 text-base leading-relaxed text-[var(--white-icon)] md:text-lg">{project.summary}</p>
            <ul class="mt-7 space-y-3 text-sm leading-relaxed text-[var(--white-icon)]">
              {project.highlights.map((highlight) => (
                <li class="flex gap-3"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-[var(--sec)]" /><span>{highlight}</span></li>
              ))}
            </ul>
            <ul class="mt-7 flex flex-wrap gap-2" aria-label={`${project.id} ${t.common.technologies}`}>
              {project.technologies.map((technology) => <li class="rounded-md bg-[var(--white-icon-tr)] px-2.5 py-1 text-xs text-[var(--sec-strong)]">{technology}</li>)}
            </ul>
            <div class="mt-8 flex flex-wrap gap-3">
              {project.links.map((link) => {
                const label = link.type === "case" ? t.common.viewCaseStudy : link.type === "article" ? t.common.readArticle : link.type === "app" ? t.common.openApplication : t.common.sourceCode;
                return (
                  <a
                    href={link.external ? link.href : localizePath(locale, link.href)}
                    data-analytics-event={link.type === "app" ? "project_live_demo_click" : undefined}
                    data-analytics-link-location={link.type === "app" ? "featured_project" : undefined}
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                    class:list={["inline-flex min-h-12 items-center justify-center rounded-xl px-5 py-3 text-sm font-medium transition-colors", link.primary ? "bg-[var(--sec)] font-semibold text-[var(--background)] transition-transform hover:-translate-y-0.5" : "border border-[var(--border)] hover:border-[var(--sec)]"]}
                  >{label}</a>
                );
              })}
            </div>
          </div>

          <div class="overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--card-bg)]">
            <a href={localizePath(locale, `/projects/${project.id}/`)} class="block">
              <img src={project.image} alt={project.imageAlt} width="1600" height="1000" loading="lazy" decoding="async" class="aspect-[16/10] w-full object-cover" />
            </a>
            <div class="border-t border-[var(--border)] p-5">
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--sec)]">{project.calloutLabel}</p>
              <p class="mt-2 text-sm leading-relaxed text-[var(--white-icon)]">{project.calloutText}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
