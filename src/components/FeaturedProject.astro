---
const sourceUrl: string | undefined = "https://github.com/albert-queralto/invoice-late-predictor-enterprise";
const liveUrl: string | undefined = "https://payrithm.albertqueralto.dev";

const technologies = [
  "Python",
  "FastAPI",
  "scikit-learn",
  "React",
  "PostgreSQL",
  "Celery",
  "Redis",
  "Docker",
];
---

<section
  id="featured-project"
  aria-labelledby="featured-project-title"
  class="border-t border-[var(--border)] py-16 text-[var(--white)] md:py-24"
>
  <div class="mx-auto max-w-5xl">
    <div class="grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14">
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.15em] text-[var(--sec)]"
        >
          Flagship project
        </p>

        <h2
          id="featured-project-title"
          class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl"
        >
          Payrithm turns invoice history into collection decisions.
        </h2>

        <p class="mt-5 text-base leading-relaxed text-[var(--white-icon)] md:text-lg">
          An accounts-receivable intelligence platform that predicts late
          payments, estimates payment timing, forecasts incoming cash, and
          converts model outputs into prioritized collection workflows.
        </p>

        <ul class="mt-7 space-y-3 text-sm leading-relaxed text-[var(--white-icon)]">
          <li class="flex gap-3">
            <span
              class="mt-2 size-1.5 shrink-0 rounded-full bg-[var(--sec)]"
            ></span>
            <span>
              Uses chronological model validation to prevent future information
              from leaking into training.
            </span>
          </li>

          <li class="flex gap-3">
            <span
              class="mt-2 size-1.5 shrink-0 rounded-full bg-[var(--sec)]"
            ></span>
            <span>
              Evaluates probability quality with ROC-AUC, calibration, and the
              Brier score.
            </span>
          </li>

          <li class="flex gap-3">
            <span
              class="mt-2 size-1.5 shrink-0 rounded-full bg-[var(--sec)]"
            ></span>
            <span>
              Combines risk, invoice value, urgency, and reminder activity into
              an explainable collection-priority score.
            </span>
          </li>
        </ul>

        <ul
          class="mt-7 flex flex-wrap gap-2"
          aria-label="Payrithm technologies"
        >
          {
            technologies.map((technology) => (
              <li class="rounded-md bg-[var(--white-icon-tr)] px-2.5 py-1 text-xs text-[var(--sec-strong)]">
                {technology}
              </li>
            ))
          }
        </ul>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/blog/payrithm/"
            class="inline-flex min-h-12 items-center justify-center rounded-xl bg-[var(--sec)] px-5 py-3 text-sm font-semibold text-[var(--background)] transition-transform hover:-translate-y-0.5"
          >
            Read the ML article
          </a>

          {
            liveUrl && (
              <a
                href={liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-12 items-center justify-center rounded-xl border border-[var(--border)] px-5 py-3 text-sm font-medium transition-colors hover:border-[var(--sec)]"
              >
                Open application
              </a>
            )
          }

          {
            sourceUrl && (
              <a
                href={sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-12 items-center justify-center rounded-xl border border-[var(--border)] px-5 py-3 text-sm font-medium transition-colors hover:border-[var(--sec)]"
              >
                Source code
              </a>
            )
          }
        </div>
      </div>

      <div
        class="overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--card-bg)]"
      >
        <img
          src="/projects/payrithm/payrithm.png"
          alt="Payrithm accounts-receivable dashboard showing invoice risk and collection priorities"
          width="1600"
          height="1000"
          loading="lazy"
          decoding="async"
          class="aspect-[16/10] w-full object-cover"
        />

        <div class="border-t border-[var(--border)] p-5">
          <p
            class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--sec)]"
          >
            End-to-end ML product
          </p>
          <p class="mt-2 text-sm leading-relaxed text-[var(--white-icon)]">
            Data ingestion, asynchronous processing, model training, prediction
            APIs, monitoring, and a decision-focused frontend.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>