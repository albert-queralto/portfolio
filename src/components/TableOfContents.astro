---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const headings = Astro.props.headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
---

{
  headings.length > 0 && (
    <aside class="hidden lg:block">
      <nav
        aria-label="Article contents"
        class="sticky top-28 rounded-2xl border border-[var(--border)] bg-[var(--card-bg)] p-5"
      >
        <p class="text-sm font-semibold text-[var(--white)]">
          On this page
        </p>

        <ol class="mt-4 space-y-2">
          {headings.map((heading) => (
            <li class:list={[heading.depth === 3 && "pl-4"]}>
              <a
                href={`#${heading.slug}`}
                class="text-sm leading-snug text-[var(--white-icon)] transition-colors hover:text-[var(--sec)]"
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </aside>
  )
}