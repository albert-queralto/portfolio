---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import { site } from "@/data/site";
import { buildBlogPosting, buildBreadcrumbList } from "@/utils/seo";
import { render } from "astro:content";
import "katex/dist/katex.min.css";
import "@/styles/prose.css";
import { dateLocales } from "@/i18n/config";
import { availableLocales, getBlogByKey, getProjectByKey } from "@/i18n/content";
import { contentLocale, getLocale, getMessages, localizePath, localizedAbsoluteUrl } from "@/i18n/utils";

interface Props { translationKey: string; }
const { translationKey } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = getMessages(locale);
const resolved = await getBlogByKey(translationKey, locale);
if (!resolved) throw new Error(`Blog post not found: ${translationKey}`);

const { entry: post, fallback, group } = resolved;
const { Content, headings } = await render(post);
const postBody = post.body ?? "";
const words = postBody.trim() ? postBody.trim().split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.ceil(words / 220));
const actualLocale = contentLocale(post.data);
const canonicalLocale = fallback ? actualLocale : locale;
const canonical = localizedAbsoluteUrl(canonicalLocale, `/blog/${translationKey}/`, Astro.site ?? site.url);
const alternateLocales = availableLocales(group);
const ogImage = post.data.cover ?? "/og/default.png";

const structuredData = fallback ? [] : [
  buildBlogPosting({
    canonical,
    title: post.data.title,
    description: post.data.description,
    published: post.data.date,
    modified: post.data.updatedDate,
    image: ogImage,
    tags: post.data.tags,
    readingTimeMinutes: readingTime,
    wordCount: words,
    section: post.data.series,
    language: actualLocale,
  }),
  buildBreadcrumbList([
    { name: t.nav.home, url: localizedAbsoluteUrl(locale, "/", Astro.site ?? site.url) },
    { name: t.nav.blog, url: localizedAbsoluteUrl(locale, "/blog/", Astro.site ?? site.url) },
    { name: post.data.title, url: canonical },
  ]),
];

const relatedProject = post.data.project
  ? await getProjectByKey(post.data.project, locale)
  : null;
---

<Layout
  title={`${post.data.title} — ${site.name}`}
  description={post.data.description}
  canonical={canonical}
  type="article"
  noindex={fallback}
  ogImage={ogImage}
  ogImageAlt={`${post.data.title} — ${site.name}`}
  structuredData={structuredData}
  alternateLocales={alternateLocales}
  alternatePath={`/blog/${translationKey}/`}
>
  <meta slot="head" property="article:published_time" content={post.data.date.toISOString()} />
  {post.data.updatedDate && <meta slot="head" property="article:modified_time" content={post.data.updatedDate.toISOString()} />}
  {post.data.tags.map((tag) => <meta slot="head" property="article:tag" content={tag} />)}

  <Nav />
  <main
    id="main-content"
    data-analytics-blog-page
    data-analytics-blog-id={translationKey}
    data-analytics-blog-title={post.data.title}
    class="mx-auto max-w-6xl py-24 text-[var(--white)] md:py-36"
  >
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_240px]">
      <article class="min-w-0" lang={actualLocale}>
        <a href={localizePath(locale, "/blog/")} class="inline-flex min-h-10 items-center gap-2 rounded-lg text-sm font-medium text-[var(--white-icon)] transition-colors hover:text-[var(--white)]">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-4"><path d="M7.83 11H20v2H7.83l5.36 5.36-1.41 1.42L4 12l7.78-7.78 1.41 1.42L7.83 11Z" /></svg>
          {t.common.backArticles}
        </a>

        {fallback && locale !== actualLocale && (
          <div class="mt-8 rounded-2xl border border-[var(--border)] bg-[var(--card-bg)] p-4 text-sm text-[var(--white-icon)]">
            <strong class="text-[var(--white)]">{t.blog.fallbackBadge}.</strong> {t.common.fallbackEnglish}
          </div>
        )}

        <header class="mt-10 border-b border-[var(--border)] pb-10">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-[var(--white-icon)]">
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString(dateLocales[actualLocale], { year: "numeric", month: "long", day: "numeric" })}
            </time>
            <span aria-hidden="true">·</span>
            <span>{readingTime} {t.common.minRead}</span>
          </div>

          <h1 class="mt-4 text-balance text-3xl font-semibold leading-tight tracking-tight md:text-5xl">{post.data.title}</h1>
          <p class="mt-5 text-base leading-relaxed text-[var(--white-icon)] md:text-lg">{post.data.description}</p>
          <ul class="mt-6 flex flex-wrap gap-2" aria-label={t.blog.topics}>
            {post.data.tags.map((tag) => (
              <li class="rounded-md bg-[var(--white-icon-tr)] px-2.5 py-1 text-xs text-[var(--sec-strong)]">{tag}</li>
            ))}
          </ul>
        </header>

        {relatedProject && (
          <aside class="mt-8 rounded-2xl border border-[var(--border)] bg-[var(--card-bg)] p-5">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--sec)]">{t.common.relatedProject}</p>
            <h2 class="mt-2 text-lg font-semibold">{relatedProject.entry.data.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-[var(--white-icon)]">{relatedProject.entry.data.description}</p>
            <a href={localizePath(locale, `/projects/${relatedProject.key}/`)} class="mt-4 inline-flex text-sm font-semibold text-[var(--sec-strong)] hover:underline">{t.common.completeCaseStudy}</a>
          </aside>
        )}

        <div data-analytics-blog-content class="article-prose prose mt-10 max-w-none prose-headings:scroll-mt-28 prose-headings:font-semibold prose-a:no-underline hover:prose-a:underline prose-code:before:content-none prose-code:after:content-none">
          <Content />
        </div>
      </article>
      <TableOfContents headings={headings} />
    </div>
  </main>
  <Footer />
</Layout>
