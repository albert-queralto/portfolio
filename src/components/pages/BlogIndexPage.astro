---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";
import { site } from "@/data/site";
import { buildBreadcrumbList } from "@/utils/seo";
import { dateLocales } from "@/i18n/config";
import { getLocalizedBlogEntries } from "@/i18n/content";
import { getLocale, getMessages, localizePath, localizedAbsoluteUrl } from "@/i18n/utils";

const locale = getLocale(Astro.currentLocale);
const t = getMessages(locale);
const posts = (await getLocalizedBlogEntries(locale)).map(({ key, entry, fallback }) => {
  const postBody = entry.body ?? "";
  return {
    key,
    entry,
    fallback,
    readingTime: Math.max(1, Math.ceil(postBody.trim().split(/\s+/).filter(Boolean).length / 220)),
  };
});

const INITIAL_POST_COUNT = 6;
const additionalPostCount = Math.max(posts.length - INITIAL_POST_COUNT, 0);
const canonical = localizedAbsoluteUrl(locale, "/blog/", Astro.site ?? site.url);
const structuredData = [
  buildBreadcrumbList([
    { name: t.nav.home, url: localizedAbsoluteUrl(locale, "/", Astro.site ?? site.url) },
    { name: t.nav.blog, url: canonical },
  ]),
];
---

<Layout
  title={`${t.blog.title} — ${site.name}`}
  description={t.blog.description}
  canonical={canonical}
  alternatePath="/blog/"
  structuredData={structuredData}
>
  <Nav />
  <main id="main-content" class="mx-auto max-w-5xl py-24 text-[var(--white)] md:py-36">
    <header class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.15em] text-[var(--sec)]">{t.blog.eyebrow}</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">{t.blog.title}</h1>
      <p class="mt-5 text-[var(--white-icon)] md:text-lg">{t.blog.description}</p>
    </header>

    <div id="blog-posts-grid" class="mt-12 grid gap-5 md:grid-cols-2">
      {
        posts.map(({ key, entry: post, fallback, readingTime }, index) => (
          <article
            data-blog-additional={index >= INITIAL_POST_COUNT ? "true" : "false"}
            class:list={[
              "group rounded-2xl border border-[var(--border)] bg-[var(--card-bg)] transition-[border-color,transform] hover:-translate-y-0.5 hover:border-[var(--sec)]",
              index >= INITIAL_POST_COUNT && "hidden",
            ]}
          >
            <a href={localizePath(locale, `/blog/${key}/`)} class="flex h-full flex-col p-6">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-[var(--white-icon)]">
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString(dateLocales[locale], {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
                <span aria-hidden="true">·</span>
                <span>{readingTime} {t.common.minRead}</span>
                {fallback && locale !== "en" && (
                  <span class="rounded-full border border-[var(--border)] px-2 py-0.5 text-[10px]">{t.blog.fallbackBadge}</span>
                )}
              </div>
              <h2 class="mt-4 text-xl font-semibold leading-snug transition-colors group-hover:text-[var(--sec)]">{post.data.title}</h2>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-[var(--white-icon)]">{post.data.description}</p>
              <ul class="mt-5 flex flex-wrap gap-2" aria-label={t.blog.topics}>
                {post.data.tags.slice(0, 3).map((tag) => (
                  <li class="rounded-md bg-[var(--white-icon-tr)] px-2 py-1 text-xs text-[var(--sec-strong)]">{tag}</li>
                ))}
              </ul>
              <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-[var(--white)]">
                {t.common.readArticle}
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-4 transition-transform group-hover:translate-x-1">
                  <path d="m16 9.41-8.6 8.61-1.42-1.41L14.59 8H7V6h11v11h-2V9.41Z" />
                </svg>
              </span>
            </a>
          </article>
        ))
      }
    </div>

    {additionalPostCount > 0 && (
      <div class="mt-10 flex justify-center">
        <button
          id="blog-expander"
          type="button"
          aria-expanded="false"
          aria-controls="blog-posts-grid"
          data-more-label={`${t.blog.showMore.replace(" →", "")} (${additionalPostCount}) →`}
          data-less-label={t.blog.showLess}
          class="inline-flex min-h-11 items-center justify-center rounded-xl border border-[var(--border)] bg-[var(--card-bg)] px-5 py-2.5 text-sm font-semibold text-[var(--white-icon)] transition-colors hover:border-[var(--sec)] hover:text-[var(--white)]"
        >
          {t.blog.showMore.replace(" →", "")} ({additionalPostCount}) →
        </button>
      </div>
    )}
  </main>
  <Footer />
</Layout>

<script>
  function setupBlogExpander() {
    const button = document.getElementById("blog-expander");
    if (!(button instanceof HTMLButtonElement) || button.dataset.initialized === "true") return;
    button.dataset.initialized = "true";

    const additionalPosts = document.querySelectorAll<HTMLElement>('[data-blog-additional="true"]');
    let expanded = false;

    const render = () => {
      additionalPosts.forEach((post) => post.classList.toggle("hidden", !expanded));
      button.setAttribute("aria-expanded", expanded ? "true" : "false");
      button.textContent = expanded
        ? button.dataset.lessLabel ?? "Show fewer articles ↑"
        : button.dataset.moreLabel ?? "View more articles →";
    };

    button.addEventListener("click", () => {
      expanded = !expanded;
      render();
    });

    render();
  }

  setupBlogExpander();
  document.addEventListener("astro:page-load", setupBlogExpander);
</script>
