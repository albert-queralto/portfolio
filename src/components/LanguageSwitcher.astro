---
import { localeNames, localeShortNames, locales } from "@/i18n/config";
import { getLocale, getMessages, localizePath, stripLocalePrefix } from "@/i18n/utils";

const locale = getLocale(Astro.currentLocale);
const t = getMessages(locale);
const path = stripLocalePrefix(Astro.url.pathname);
---

<div class="relative">
  <details class="group language-switcher">
    <summary
      class="flex min-h-10 cursor-pointer list-none items-center gap-1.5 rounded-xl border border-[var(--border)] px-2.5 text-xs font-semibold text-[var(--white-icon)] transition-colors hover:border-[var(--sec)] hover:text-[var(--white)] md:px-3"
      aria-label={t.language.select}
      title={localeNames[locale]}
    >
      <span aria-hidden="true">{localeShortNames[locale]}</span>
      <svg viewBox="0 0 20 20" fill="currentColor" class="size-4 transition-transform group-open:rotate-180" aria-hidden="true">
        <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.51a.75.75 0 0 1-1.08 0l-4.25-4.51a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
      </svg>
    </summary>

    <div class="absolute bottom-full right-0 z-[110] mb-2 min-w-40 overflow-hidden rounded-xl border border-[var(--border)] bg-[var(--component-bg)] p-1 shadow-2xl md:bottom-auto md:top-full md:mb-0 md:mt-2">
      {
        locales.map((targetLocale) => (
          <a
            href={localizePath(targetLocale, path)}
            hreflang={targetLocale}
            lang={targetLocale}
            aria-current={targetLocale === locale ? "page" : undefined}
            class:list={[
              "block rounded-lg px-3 py-2 text-sm transition-colors",
              targetLocale === locale
                ? "bg-[var(--sec)] text-[var(--background)]"
                : "text-[var(--white-icon)] hover:bg-[var(--white-icon-tr)] hover:text-[var(--white)]",
            ]}
          >
            {localeNames[targetLocale]}
          </a>
        ))
      }
    </div>
  </details>
</div>

<style>
  summary::-webkit-details-marker { display: none; }
</style>
