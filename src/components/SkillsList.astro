---
import { getLocale, getMessages } from "@/i18n/utils";

const locale = getLocale(Astro.currentLocale);
const t = getMessages(locale);
const categories = t.home.skills.map(([title, summary, items]) => ({ title, summary, items }));
---

<div class="space-y-3" aria-label={t.home.howLabel}>
  {
    categories.map((category, index) => (
      <details open={index === 0} class="group overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--card-bg)]">
        <summary class="flex cursor-pointer list-none items-start gap-3 p-4 transition-colors hover:bg-[var(--white-icon-tr)]">
          <span class="min-w-0 flex-1">
            <span class="block font-semibold text-[var(--white)]">{category.title}</span>
            <span class="mt-0.5 block text-sm text-[var(--white-icon)]">{category.summary}</span>
          </span>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="mt-1 size-5 shrink-0 text-[var(--white-icon)] transition-transform group-open:rotate-180">
            <path d="m12 15.17 6.36-6.36-1.41-1.42L12 12.34 7.05 7.39 5.64 8.81 12 15.17Z" />
          </svg>
        </summary>
        <ul class="space-y-2 border-t border-[var(--border)] px-5 py-4 text-sm leading-relaxed text-[var(--white-icon)]">
          {category.items.map((item) => (
            <li class="flex gap-3">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-[var(--sec)]" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </details>
    ))
  }
</div>
