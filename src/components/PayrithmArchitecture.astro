---
import { getLocale, getMessages } from "@/i18n/utils";
import { architectureByLocale } from "@/i18n/architecture";
const locale = getLocale(Astro.currentLocale);
const t = getMessages(locale);
const architecture = architectureByLocale[locale].payrithm;
const [frontend, api, database, workers, redis, pipeline] = architecture.boxes;
---
<section aria-labelledby="architecture-title" class="my-12 rounded-2xl border border-[var(--border)] bg-[var(--card-bg)] p-5 md:p-8">
  <div class="max-w-2xl">
    <p class="text-xs font-semibold uppercase tracking-[0.15em] text-[var(--sec)]">{t.projectPage.systemDesign}</p>
    <h2 id="architecture-title" class="mt-2 text-2xl font-semibold">{architecture.title}</h2>
  </div>
  <div class="mt-8 grid items-center gap-3 md:grid-cols-[1fr_auto_1fr_auto_1fr]">
    <div class="architecture-box"><strong>{frontend[0]}</strong><span>{frontend[1]}</span></div><span class="architecture-arrow" aria-hidden="true">→</span>
    <div class="architecture-box"><strong>{api[0]}</strong><span>{api[1]}</span></div><span class="architecture-arrow" aria-hidden="true">→</span>
    <div class="architecture-box"><strong>{database[0]}</strong><span>{database[1]}</span></div>
  </div>
  <div class="my-3 flex justify-center" aria-hidden="true"><span class="text-xl text-[var(--sec)]">↓</span></div>
  <div class="grid items-center gap-3 md:grid-cols-[1fr_auto_1fr_auto_1fr]">
    <div class="architecture-box"><strong>{workers[0]}</strong><span>{workers[1]}</span></div><span class="architecture-arrow" aria-hidden="true">↔</span>
    <div class="architecture-box"><strong>{redis[0]}</strong><span>{redis[1]}</span></div><span class="architecture-arrow" aria-hidden="true">↔</span>
    <div class="architecture-box"><strong>{pipeline[0]}</strong><span>{pipeline[1]}</span></div>
  </div>
</section>
<style>
  .architecture-box { display:flex; min-height:9rem; flex-direction:column; justify-content:center; border:1px solid var(--border); border-radius:1rem; background:var(--background); padding:1.25rem; }
  .architecture-box strong { color:var(--white); }
  .architecture-box span { margin-top:.5rem; color:var(--white-icon); font-size:.875rem; line-height:1.6; }
  .architecture-arrow { text-align:center; color:var(--sec); font-size:1.5rem; }
  @media (max-width:767px) { .architecture-arrow { transform:rotate(90deg); } }
</style>
